static func build(parent: Node3D) -> void:
	var materials: Dictionary = {}
	var index := 0
	for data in VOXELS:
		var color := Color8(int(data[6]), int(data[7]), int(data[8]), 255)
		var key := color.to_html(false)
		var material: StandardMaterial3D
		if materials.has(key):
			material = materials[key] as StandardMaterial3D
		else:
			material = StandardMaterial3D.new()
			material.albedo_color = color
			material.metallic = 0.02
			material.roughness = 0.86
			materials[key] = material

		var voxel := MeshInstance3D.new()
		voxel.name = "%s_%03d" % [String(data[0]), index]
		var box := BoxMesh.new()
		box.size = Vector3(float(data[4]) * 1.015, float(data[4]) * 1.015, float(data[5]))
		voxel.mesh = box
		voxel.position = Vector3(float(data[1]), float(data[2]), float(data[3]))
		voxel.material_override = material
		parent.add_child(voxel)
		index += 1
